{
  "manifest_version": 3,
  "name": "Lecture Script · 강의 자동 저장",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "description": "강의 창을 열면 동영상 → 음성 → 자막 스크립트를 다운로드/lecture/과목명에 저장합니다.",
  "key": "",
  "permissions": ["storage", "tabs", "webRequest", "webNavigation", "cookies", "nativeMessaging", "scripting", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "강의 자동 저장", "default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://learn.hansung.ac.kr/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
